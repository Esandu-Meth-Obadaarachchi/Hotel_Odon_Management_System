# Template — copy to .env and fill in. .env is git-ignored; this file is not,
# so never put a real secret here.
# Railway gets the same variables as project variables instead of a file.

# ── AI insight reports ───────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
AI_REPORT_SECRET=pick-a-long-random-string

# ── Database ─────────────────────────────────────────────────────────────────
# Required. The server refuses to start without it.
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster1.example.mongodb.net/hotel?retryWrites=true&w=majority

# ── Firebase sign-in ─────────────────────────────────────────────────────────
# Required for token verification; without it every sign-in is rejected.
FIREBASE_PROJECT_ID=odon-dashboard-fin

# Seeds the allow-list on first boot only. After that the database is the source
# of truth and the admin screen edits it.
ALLOWED_EMAILS=owner@example.com,manager@example.com

# 'true' rejects hotel-app requests that carry no sign-in. Leave false until
# mobile has Google sign-in, or the front desk gets locked out. Does not affect
# the AI report routes, which use AI_REPORT_SECRET.
AUTH_ENFORCE=false

# ── Bookings cache (Upstash Redis, REST API) ─────────────────────────────────
# Optional. With these unset the server reads Mongo on every request; set them
# and the /bookings list is served from Redis and dropped on every write.
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token
# Seconds a cached list may live before it is rebuilt. Writes invalidate it
# immediately, so this only bounds edits made outside this API. Default 300.
BOOKINGS_CACHE_TTL=300
